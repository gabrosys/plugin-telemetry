#!/usr/bin/env bash
# Fake cmctl for the dev-env tests. State lives in $FAKE_STATE.
set -euo pipefail

state=${FAKE_STATE:?}
echo "cmctl $*" >>"$state/calls"

case "$*" in
"check api --context "*" --wait="*)
	if [[ -e $state/cert-manager-api-down ]]; then
		echo "Not ready: the cert-manager webhook deployment is not ready yet" >&2
		exit 1
	fi
	echo "The cert-manager API is ready"
	;;
*)
	echo "fake cmctl: unexpected: $*" >&2
	exit 99
	;;
esac
